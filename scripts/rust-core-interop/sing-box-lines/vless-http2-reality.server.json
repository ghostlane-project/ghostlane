{
  "about": "VLESS over HTTP/2 (type=http, host and path) over REALITY, a sing-box server",
  "shape": "vless-http2-reality",
  "expect": "page",
  "link": "vless://77777777-7777-7777-7777-777777777777@127.0.0.1:{port}?security=reality&encryption=none&pbk={public_key}&sid=ab12cd34&fp=chrome&sni=reality.interop.test&type=http&path=%2Fmedia%2Fh2&host=front.interop.test#interop-vless-http2-reality",
