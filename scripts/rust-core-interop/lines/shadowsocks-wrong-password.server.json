{
  "about": "the AEAD line with a password the server does not hold: a pass would prove the password is never checked",
  "shape": "shadowsocks",
  "expect": "refused",
  "against": "shadowsocks-aes-256-gcm",
  "link": "ss://aes-256-gcm:pw-aes-257@127.0.0.1:{port}#interop-shadowsocks-wrong-password",
  "inbounds": [
    {
      "tag": "in",
      "listen": "127.0.0.1",
      "port": "{port}",
      "protocol": "shadowsocks",
      "settings": {
        "method": "aes-256-gcm",
        "password": "pw-aes-256",
        "network": "tcp,udp"
      }
    }
  ]
}
