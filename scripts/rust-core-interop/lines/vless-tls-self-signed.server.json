{
  "about": "the same raw TCP link without allowInsecure: the core must refuse a certificate no public root signed",
  "shape": "vless-tls",
  "expect": "refused",
  "against": "vless-tls-insecure",
  "tls_name": "vless.interop.test",
  "link": "vless://44444444-4444-4444-4444-444444444444@127.0.0.1:{port}?security=tls&encryption=none&sni=vless.interop.test&fp=chrome&type=tcp#interop-vless-tls-self-signed",
  "inbounds": [
    {
      "tag": "in",
      "listen": "127.0.0.1",
      "port": "{port}",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "44444444-4444-4444-4444-444444444444"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "{cert_file}",
              "keyFile": "{key_file}"
            }
          ]
        }
      }
    }
  ]
}
