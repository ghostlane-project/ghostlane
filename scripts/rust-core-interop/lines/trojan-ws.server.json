{
  "about": "Trojan over WebSocket with TLS, the server ending TLS with http/1.1 as nginx in front of one does",
  "shape": "trojan-ws",
  "expect": "page",
  "tls_name": "trojan.interop.test",
  "trust": "pin",
  "link": "trojan://trojan-interop-password@127.0.0.1:{port}?security=tls&sni=trojan.interop.test&fp=chrome&type=ws&path=%2Ftr&host=trojan.interop.test#interop-trojan-ws",
  "mutant": {
    "pointer": "/outbounds/0/settings/servers/0/password",
    "value": "trojan-interop-passwore"
  },
  "inbounds": [
    {
      "tag": "in",
      "listen": "127.0.0.1",
      "port": "{port}",
      "protocol": "trojan",
      "settings": {
        "clients": [
          {
            "password": "trojan-interop-password",
            "email": "interop@test"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/tr"
        },
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "http/1.1"
          ],
          "certificates": [
            {
              "certificateFile": "{cert_file}",
              "keyFile": "{key_file}"
            }
          ]
        }
      }
    }
  ]
}
