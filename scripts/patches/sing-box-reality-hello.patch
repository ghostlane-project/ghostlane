diff -ruN a/common/tls/reality_ghostlane.go b/common/tls/reality_ghostlane.go
--- a/common/tls/reality_ghostlane.go
+++ b/common/tls/reality_ghostlane.go
@@ -0,0 +1,33 @@
+//go:build with_utls
+
+package tls
+
+import utls "github.com/metacubex/utls"
+
+// RealityAnnouncedVersion is the client version a Reality hello announces in
+// its session id. Ghostlane's patch (scripts/patches/sing-box-reality-hello.patch
+// in ghostlane-project/ghostlane) sets it to the Xray-core version the app
+// ships beside this sing-box; a tree without the patch has no such name, so
+// whatever refers to it does not compile against an unpatched sing-box.
+var RealityAnnouncedVersion = [3]byte{26, 7, 11}
+
+// realityHelloOffersHybridFirst reports whether the built hello carries an
+// X25519MLKEM768 key share ahead of any X25519 share: the order REALITY
+// servers since XTLS/REALITY 8cdf7bf accept. GREASE shares are skipped.
+func realityHelloOffersHybridFirst(uConn *utls.UConn) bool {
+	for _, extension := range uConn.Extensions {
+		keyShares, ok := extension.(*utls.KeyShareExtension)
+		if !ok {
+			continue
+		}
+		for _, share := range keyShares.KeyShares {
+			switch share.Group {
+			case utls.X25519MLKEM768:
+				return true
+			case utls.X25519:
+				return false
+			}
+		}
+	}
+	return false
+}
