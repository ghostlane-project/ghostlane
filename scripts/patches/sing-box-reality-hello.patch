diff -ruN a/common/tls/reality_ghostlane.go b/common/tls/reality_ghostlane.go
--- a/common/tls/reality_ghostlane.go
+++ b/common/tls/reality_ghostlane.go
@@ -0,0 +1,240 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	utls "github.com/metacubex/utls"
+)
+
+// RealityAnnouncedVersion is the client version a Reality hello announces in
+// its session id. Ghostlane's patch (scripts/patches/sing-box-reality-hello.patch
+// in ghostlane-project/ghostlane) sets it to the Xray-core version the app
+// ships beside this sing-box; a tree without the patch has no such name, so
+// whatever refers to it does not compile against an unpatched sing-box.
+var RealityAnnouncedVersion = [3]byte{26, 7, 11}
+
+// realityHelloOffersHybridFirst reports whether the built hello carries an
+// X25519MLKEM768 key share ahead of any X25519 share: the order REALITY
+// servers since XTLS/REALITY 8cdf7bf accept. GREASE shares are skipped.
+func realityHelloOffersHybridFirst(uConn *utls.UConn) bool {
+	for _, extension := range uConn.Extensions {
+		keyShares, ok := extension.(*utls.KeyShareExtension)
+		if !ok {
+			continue
+		}
+		for _, share := range keyShares.KeyShares {
+			switch share.Group {
+			case utls.X25519MLKEM768:
+				return true
+			case utls.X25519:
+				return false
+			}
+		}
+	}
+	return false
+}
+
+// realityHelloStripHybrid takes the X25519MLKEM768 group and key share out
+// of a built hello, exactly as sing-box does for every Reality hello without
+// this patch: the short hello is that one, not a new one.
+func realityHelloStripHybrid(uConn *utls.UConn) {
+	for _, extension := range uConn.Extensions {
+		if ce, ok := extension.(*utls.SupportedCurvesExtension); ok {
+			ce.Curves = common.Filter(ce.Curves, func(curveID utls.CurveID) bool {
+				return curveID != utls.X25519MLKEM768
+			})
+		}
+		if ks, ok := extension.(*utls.KeyShareExtension); ok {
+			ks.KeyShares = common.Filter(ks.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group != utls.X25519MLKEM768
+			})
+		}
+	}
+}
+
+// realityHelloAttempt is one handshake of the hello fallback: which hello it
+// sends, and how it ended.
+type realityHelloAttempt struct {
+	short bool
+	// Not one byte came back within the window.
+	unanswered bool
+	// The server showed a certificate that is not REALITY's own.
+	realCertificate bool
+}
+
+// realityFirstByteWatch closes a connection that has delivered no byte when
+// its window is up. Any byte ends the watch for good: a server that answered
+// got the hello, whatever it made of it.
+type realityFirstByteWatch struct {
+	net.Conn
+	answered atomic.Bool
+	access   sync.Mutex
+	gaveUp   bool
+	timer    *time.Timer
+}
+
+func watchRealityFirstByte(conn net.Conn, window time.Duration) *realityFirstByteWatch {
+	w := &realityFirstByteWatch{Conn: conn}
+	w.access.Lock()
+	w.timer = time.AfterFunc(window, w.giveUp)
+	w.access.Unlock()
+	return w
+}
+
+func (w *realityFirstByteWatch) giveUp() {
+	w.access.Lock()
+	defer w.access.Unlock()
+	if w.answered.Load() {
+		return
+	}
+	w.gaveUp = true
+	_ = w.Conn.Close()
+}
+
+func (w *realityFirstByteWatch) Read(p []byte) (int, error) {
+	n, err := w.Conn.Read(p)
+	if n > 0 && !w.answered.Load() {
+		w.access.Lock()
+		if !w.gaveUp {
+			w.answered.Store(true)
+			w.timer.Stop()
+		}
+		w.access.Unlock()
+	}
+	return n, err
+}
+
+// end stops the watch and says whether it gave the connection up.
+func (w *realityFirstByteWatch) end() bool {
+	w.access.Lock()
+	defer w.access.Unlock()
+	w.timer.Stop()
+	return w.gaveUp
+}
+
+func (w *realityFirstByteWatch) Upstream() any {
+	return w.Conn
+}
+
+func (w *realityFirstByteWatch) ReaderReplaceable() bool {
+	return w.answered.Load()
+}
+
+func (w *realityFirstByteWatch) WriterReplaceable() bool {
+	return true
+}
+
+// dialRealityWithHelloPlan dials a Reality server for the TLS dialer
+// (client.go), the one place that both connects and shakes hands and so can
+// connect again. It reports false, having done nothing, when the config is
+// not a Reality client's or the short hello is known not to help at this
+// server: the dial then runs as it does without the fallback.
+//
+//  1. With nothing remembered for the server the long hello is sent and
+//     watched. When not one byte of answer arrives within
+//     RealityHelloStallWindow, that connection is closed and one more is
+//     made, once, with the short hello, watched the same way.
+//  2. A server that answers is never retried: any byte ends the watch, an
+//     alert or a handshake that then fails included.
+//  3. The retry's outcome is remembered for the server. It opened the line:
+//     later dials start with the short hello. It went unanswered too, or met
+//     a real certificate (a server from Xray-core v26.9.8 on hands a hello
+//     without the hybrid share to its camouflage target): the dial fails
+//     with the stall as its error and later dials are left alone. A retry
+//     that ends any other way (a reset, a close, a failed connect) fails the
+//     dial with the stall and is not remembered: it says nothing about the
+//     hello.
+//
+// What the retry gives up: the connection it opens is keyed by X25519 alone,
+// as every Reality connection of an unpatched sing-box is. REALITY's own
+// authentication is the same for both hellos. Whoever can drop the second
+// segment of a hello can force the retry, and can as well drop the whole
+// connection.
+//
+// Not covered: a handshake on a connection somebody else dialed
+// (RealityClientConfig.Client and ClientHandshake, which the gRPC transport
+// of a `with_grpc` build uses), and a Reality client under kTLS.
+func dialRealityWithHelloPlan(ctx context.Context, dialer N.Dialer, config Config, destination M.Socksaddr) (Conn, bool, error) {
+	e, isReality := config.(*RealityClientConfig)
+	if !isReality {
+		return nil, false, nil
+	}
+	server := RealityHelloServer{Address: destination.String(), ServerName: e.ServerName()}
+	recalled, epoch := realityHelloMemory.Recall(server, time.Now())
+	switch recalled {
+	case RealityShortHelloDoesNotHelp:
+		return nil, false, nil
+	case RealityShortHelloWorks:
+		conn, _, err := e.dialWithHello(ctx, dialer, destination, true, 0)
+		if err != nil {
+			realityHelloMemory.Forget(server, epoch)
+		}
+		return conn, true, err
+	}
+
+	conn, attempt, stall := e.dialWithHello(ctx, dialer, destination, false, RealityHelloStallWindow)
+	if !attempt.unanswered {
+		return conn, true, stall
+	}
+	e.helloDebug(ctx, "reality: no answer to the hello from ", destination, " in ", RealityHelloStallWindow, ", one retry with the short hello")
+
+	conn, attempt, err := e.dialWithHello(ctx, dialer, destination, true, RealityHelloStallWindow)
+	verdict := RealityShortHelloUnknown
+	switch {
+	case err == nil:
+		verdict = RealityShortHelloWorks
+	case attempt.unanswered || attempt.realCertificate:
+		verdict = RealityShortHelloDoesNotHelp
+	}
+	if realityHelloMemory.Remember(server, epoch, verdict, time.Now()) {
+		e.helloDebug(ctx, "reality: the short hello ", verdict, " at ", destination, ", remembered for ", RealityHelloMemoryTTL)
+	}
+	if err != nil {
+		return nil, true, stall
+	}
+	return conn, true, nil
+}
+
+func (e *RealityClientConfig) helloDebug(ctx context.Context, args ...any) {
+	if e.logger != nil {
+		e.logger.DebugContext(ctx, args...)
+	}
+}
+
+// dialWithHello makes one connection and one handshake: with the short hello
+// or the long one, watched for a first byte when window is not zero.
+func (e *RealityClientConfig) dialWithHello(ctx context.Context, dialer N.Dialer, destination M.Socksaddr, short bool, window time.Duration) (Conn, realityHelloAttempt, error) {
+	attempt := &realityHelloAttempt{short: short}
+	conn, err := dialer.DialContext(ctx, N.NetworkTCP, destination)
+	if err != nil {
+		return nil, *attempt, err
+	}
+	config := *e
+	config.helloAttempt = attempt
+	var watch *realityFirstByteWatch
+	if window > 0 {
+		watch = watchRealityFirstByte(conn, window)
+		conn = watch
+	}
+	tlsConn, err := config.ClientHandshake(ctx, conn)
+	if watch != nil && watch.end() {
+		attempt.unanswered = true
+		err = E.New("reality: no answer to the hello in ", window)
+	}
+	if err != nil {
+		conn.Close()
+		return nil, *attempt, err
+	}
+	return tlsConn, *attempt, nil
+}
