diff -ruN a/common/tls/reality_hello_ghostlane.go b/common/tls/reality_hello_ghostlane.go
--- a/common/tls/reality_hello_ghostlane.go
+++ b/common/tls/reality_hello_ghostlane.go
@@ -0,0 +1,179 @@
+package tls
+
+import (
+	"sync"
+	"time"
+)
+
+// Ghostlane: what the Reality hello fallback remembers (the dial itself is in
+// reality_ghostlane.go; scripts/patches/sing-box-reality-hello.patch in
+// ghostlane-project/ghostlane).
+//
+// A Reality hello with the X25519MLKEM768 key share is about 1.8 KB and
+// leaves in two TCP segments. Some networks deliver the first and never the
+// second, retransmissions included: the server waits for the end of the
+// hello and the client for an answer. The short hello, the one sing-box
+// sends without the patch, has no such share and fits one segment.
+const (
+	// RealityHelloStallWindow is how long a watched hello may go without one
+	// byte of answer, from the start of the TLS handshake on a connected
+	// socket. A lost segment is sent again after about one second and again
+	// two seconds later: four seconds let both through, so a path that
+	// merely loses a packet is not read as one that eats the hello.
+	RealityHelloStallWindow = 4 * time.Second
+	// RealityHelloMemoryTTL is how long one server's outcome is kept: the
+	// dials of a session do not each pay the stall, and a path that heals
+	// gets the long hello back within minutes.
+	RealityHelloMemoryTTL = 10 * time.Minute
+	// RealityHelloMemoryCapacity is how many servers are remembered; one
+	// more pushes the oldest out.
+	RealityHelloMemoryCapacity = 64
+)
+
+// RealityShortHello is what is known of the short hello at one server.
+type RealityShortHello int
+
+const (
+	// RealityShortHelloUnknown: nothing is remembered. The long hello is
+	// sent and watched.
+	RealityShortHelloUnknown RealityShortHello = iota
+	// RealityShortHelloWorks: it opened the line after the long hello had
+	// gone unanswered. Dials send it first, unwatched.
+	RealityShortHelloWorks
+	// RealityShortHelloDoesNotHelp: it went unanswered as well, or the
+	// server handed it to its camouflage target. Dials send the long hello
+	// alone, unwatched, as without the fallback.
+	RealityShortHelloDoesNotHelp
+)
+
+func (v RealityShortHello) String() string {
+	switch v {
+	case RealityShortHelloWorks:
+		return "works"
+	case RealityShortHelloDoesNotHelp:
+		return "does not help"
+	default:
+		return "unknown"
+	}
+}
+
+// RealityHelloServer is one server as the memory knows it: the address
+// dialed ("host:port") and the server name the hello asks for.
+type RealityHelloServer struct {
+	Address    string
+	ServerName string
+}
+
+type realityHelloEntry struct {
+	server  RealityHelloServer
+	verdict RealityShortHello
+	until   time.Time
+}
+
+// RealityHelloMemory holds the outcomes, oldest first. Every method takes
+// the time, so nothing here owns a clock, a goroutine or a timer. The zero
+// value is an empty memory.
+type RealityHelloMemory struct {
+	access  sync.Mutex
+	entries []realityHelloEntry
+	epoch   uint64
+}
+
+// Recall returns what is remembered for the server at `now`, and the
+// memory's epoch: Clear moves it on, and an outcome a dial brings back from
+// an earlier epoch is not written.
+func (m *RealityHelloMemory) Recall(server RealityHelloServer, now time.Time) (RealityShortHello, uint64) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	return m.recall(server, now), m.epoch
+}
+
+func (m *RealityHelloMemory) recall(server RealityHelloServer, now time.Time) RealityShortHello {
+	for index, entry := range m.entries {
+		if entry.server != server {
+			continue
+		}
+		if !entry.until.After(now) {
+			m.entries = append(m.entries[:index], m.entries[index+1:]...)
+			return RealityShortHelloUnknown
+		}
+		return entry.verdict
+	}
+	return RealityShortHelloUnknown
+}
+
+// Remember writes the verdict for the server and says whether it did.
+// Nothing is written for a dial that began before the memory was last
+// cleared, and "does not help" is not written over an unexpired "works": a
+// burst of dials that stall together retry together, and the one retry that
+// meets a loss would otherwise turn the fallback off for all of them.
+func (m *RealityHelloMemory) Remember(server RealityHelloServer, epoch uint64, verdict RealityShortHello, now time.Time) bool {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if epoch != m.epoch || verdict == RealityShortHelloUnknown {
+		return false
+	}
+	if verdict == RealityShortHelloDoesNotHelp && m.recall(server, now) == RealityShortHelloWorks {
+		return false
+	}
+	kept := m.entries[:0]
+	for _, entry := range m.entries {
+		if entry.until.After(now) && entry.server != server {
+			kept = append(kept, entry)
+		}
+	}
+	if len(kept) >= RealityHelloMemoryCapacity {
+		kept = append(kept[:0], kept[len(kept)-RealityHelloMemoryCapacity+1:]...)
+	}
+	m.entries = append(kept, realityHelloEntry{server, verdict, now.Add(RealityHelloMemoryTTL)})
+	return true
+}
+
+// Forget takes the server out, unless the dial began before the memory was
+// last cleared: what is there now was learnt after it.
+func (m *RealityHelloMemory) Forget(server RealityHelloServer, epoch uint64) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if epoch != m.epoch {
+		return
+	}
+	for index, entry := range m.entries {
+		if entry.server == server {
+			m.entries = append(m.entries[:index], m.entries[index+1:]...)
+			return
+		}
+	}
+}
+
+// Clear empties the memory and starts a new epoch.
+func (m *RealityHelloMemory) Clear() {
+	m.access.Lock()
+	defer m.access.Unlock()
+	m.entries = nil
+	m.epoch++
+}
+
+// Len is how many servers are held, expired ones included until they are
+// next looked at.
+func (m *RealityHelloMemory) Len() int {
+	m.access.Lock()
+	defer m.access.Unlock()
+	return len(m.entries)
+}
+
+// The process-wide memory: every Reality outbound of every instance.
+var realityHelloMemory RealityHelloMemory
+
+// RealityHelloNetworkReset empties the process-wide memory: the network the
+// outcomes were seen on is gone (route.NetworkManager.ResetNetwork). A dial
+// under way learnt its outcome on the old network and writes nothing.
+func RealityHelloNetworkReset() {
+	realityHelloMemory.Clear()
+}
+
+// RealityShortHelloAt is what the process-wide memory holds for the server
+// now.
+func RealityShortHelloAt(server RealityHelloServer) RealityShortHello {
+	verdict, _ := realityHelloMemory.Recall(server, time.Now())
+	return verdict
+}
