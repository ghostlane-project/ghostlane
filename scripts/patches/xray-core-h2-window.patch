+// h2StreamWindowFlag and h2ConnWindowFlag bound what the HTTP/2 client lets
+// the server send ahead of the reader: the per-stream and per-connection
+// receive windows, in bytes. x/net's defaults are 4 MB per stream and 1 GB
+// per connection. On a host that is killed at about 50 MB — an iOS packet
+// tunnel provider — that is the buffer which fills the moment the tun path
+// drains slower than the link, one window per download stream. Unset or
+// non-positive keeps the defaults.
+var (
+	h2StreamWindowFlag = platform.NewEnvFlag("xray.xhttp.h2.stream.window")
+	h2ConnWindowFlag   = platform.NewEnvFlag("xray.xhttp.h2.conn.window")
+)
+
+// newH2Transport returns the HTTP/2 transport for xhttp, honouring the
+// receive-window flags. x/net reads those windows only from a net/http
+// Transport's HTTP2 config, so a throwaway one carries them into
+// http2.ConfigureTransports; the no-dial connection pool that call installs
+// is dropped again so the transport dials on its own, as it always has.
+func newH2Transport() *http2.Transport {
+	streamWindow := h2StreamWindowFlag.GetValueAsInt(0)
+	connWindow := h2ConnWindowFlag.GetValueAsInt(0)
+	if streamWindow <= 0 && connWindow <= 0 {
+		return &http2.Transport{}
+	}
+	t1 := &http.Transport{HTTP2: &http.HTTP2Config{}}
+	if streamWindow > 0 {
+		t1.HTTP2.MaxReceiveBufferPerStream = streamWindow
+	}
+	if connWindow > 0 {
+		t1.HTTP2.MaxReceiveBufferPerConnection = connWindow
+	}
+	t2, err := http2.ConfigureTransports(t1)
+	if err != nil {
+		errors.LogWarningInner(context.Background(), err, "xhttp: h2 receive window not applied")
+		return &http2.Transport{}
+	}
+	t2.ConnPool = nil
+	return t2
+}
+
